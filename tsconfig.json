{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // -------------------------------------------------------------------
    // Rigor. O projeto de referência era JS puro e engolia em silêncio erros
    // que só apareciam em produção — um hook devolvia `{ isAuthenticated,
    // loading }` e três páginas desestruturavam `logout`, deixando o botão
    // "Sair" como um `onClick={undefined}` que ninguém percebeu.
    // Ver docs/00-analise-dalia.md, achado D29.
    // -------------------------------------------------------------------
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    // Só TypeScript. Nada de .js se infiltrando no src/.
    "allowJs": false,
    "checkJs": false,

    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "src/generated"]
}
