# =============================================================================
# Caqui Trekking — variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env` e preencha os valores:
#
#     cp .env.example .env
#
# REGRA INEGOCIÁVEL: nenhuma variável abaixo tem valor padrão no código.
# Se faltar, a aplicação NÃO sobe (ver src/lib/env.ts).
# Nada de `process.env.X || 'algum-fallback'` — um app que sobe com segredo
# default é pior que um app que não sobe, porque falha em silêncio.
#
# NUNCA comite o `.env`. Ele está no .gitignore; este `.example` não está.
# =============================================================================


# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------
# PostgreSQL 16. Em desenvolvimento local (Homebrew), o usuário costuma ser o
# seu próprio usuário do sistema e não há senha:
#   postgresql://SEU_USUARIO@localhost:5432/caqui_trekking_dev
#
# Crie os bancos com:
#   createdb caqui_trekking_dev
#   createdb caqui_trekking_test
DATABASE_URL="postgresql://usuario@localhost:5432/caqui_trekking_dev"


# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------
# development | test | production
NODE_ENV="development"

# URL pública do site, sem barra no final. Usada em canônicas, sitemap,
# Open Graph e JSON-LD. Precisa ser a URL real em produção, senão os previews
# de link no WhatsApp apontam para o lugar errado.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# AUTENTICAÇÃO
# -----------------------------------------------------------------------------
# Segredo que assina o cookie de sessão. Mínimo 32 caracteres — a aplicação
# NÃO SOBE se for menor. Gere um novo com:
#   openssl rand -base64 48
#
# Trocar este valor invalida todas as sessões abertas. Nunca reutilize entre
# ambientes: staging e produção precisam de segredos diferentes.
AUTH_SECRET=""


# =============================================================================
# AINDA NÃO USADAS — entram nas fases seguintes.
# Listadas aqui para o setup não ser descoberto aos pedaços.
# =============================================================================

# -----------------------------------------------------------------------------
# SEED
# -----------------------------------------------------------------------------
# Primeiro usuário OWNER, consumido APENAS pelo script de seed.
# Nunca lida em runtime pela aplicação. Mínimo 12 caracteres.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""

# =============================================================================
# MÍDIA — Cloudinary
# =============================================================================
# Regra diferente das de cima, e de propósito: as três são opcionais EM
# CONJUNTO e obrigatórias EM CONJUNTO. Preenchidas pela metade, a aplicação
# NÃO sobe — configuração parcial é o pior dos três estados, porque parece
# pronta e só falha quando alguém tenta subir uma foto.
#
# Sem nenhuma delas o site inteiro funciona: catálogo, agenda, carrinho e CRM.
# Só o upload não. A rota responde 503 MEDIA_STORAGE_UNCONFIGURED nomeando o
# que falta, em vez de "erro ao enviar a imagem".
#
# Onde achar: painel do Cloudinary → Settings → API Keys.
# O SECRET assina as requisições. Trate como senha: nunca no front, nunca no
# repositório, e diferente entre staging e produção.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
